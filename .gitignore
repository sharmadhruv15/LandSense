# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & credentials
.env
.env.*
*.key
*.pem
kaggle.json

# Model checkpoints & large binary files (>100MB or binary weights)
*.pth
*.pt
*.ckpt
*.onnx
*.pkl

# Satellite datasets & large data files
*.h5
*.hdf5
*.zip
*.tar
*.tar.gz
*.7z
*.tif
*.tiff

# Runtime uploads & generated output files
uploads/
outputs/visualizations/*
!outputs/visualizations/.gitkeep
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/*.png
outputs/*.jpg

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs & Editor configurations
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
